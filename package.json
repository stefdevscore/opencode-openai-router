{
  "name": "opencode-openai-router",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "docs",
    "scripts"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "check:docs": "node scripts/check-docs.mjs",
    "probe:host": "node scripts/probe-host.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@opencode-ai/plugin": {
      "zod": "^4.6.7",
      "effect": {
        "toml": "^5.0.1"
      }
    }
  }
}
