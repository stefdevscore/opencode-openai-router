{
  "name": "opencode-openai-router",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "research",
    "server.js"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "check:docs": "node scripts/check-docs.mjs",
    "probe:status": "node scripts/probe-v2-gui-rpc.mjs"
  },
  "devDependencies": {
    "@opencode/client": "2.2.0",
    "@opencode/plugin": "2.2.0",
    "@types/node": "^24.19.2",
    "solid-js": "1.9.17",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.14"
  }
}
